# Every var genzen reads, and whether it is required.
#
# You do not need this file to develop. `pnpm local:up` writes `.env.local`
# itself and asks only for FAL_KEY. This is the reference for deploying, and
# it is the contract: if the app reads a var, it appears here.
#
# genzen has never been deployed. This describes what a deployment would
# need, not a running one.

# ─── Required ─────────────────────────────────────────────────────────

# Postgres 17. Locally the `postgres` service in docker-compose.yml.
DATABASE_URL=

# Signing key for the session cookie. Any long random string --
# `openssl rand -hex 32`. Rotating it invalidates every existing session.
AUTH_SESSION_SECRET=

# Image generation — https://fal.ai/dashboard/keys
FAL_KEY=

# Storage. Any S3-compatible bucket; the R2_ prefix is historical (#225) and
# the client is provider-agnostic. Set R2_ENDPOINT explicitly, or set
# R2_ACCOUNT_ID alone to derive Cloudflare R2's endpoint.
#
# The bucket must be PRIVATE (#226). Nothing reads it without credentials --
# the app serves images itself through /img/[id], which checks the session.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# ─── Optional ─────────────────────────────────────────────────────────

# Only read when R2_ENDPOINT is unset, to derive Cloudflare R2's endpoint.
R2_ACCOUNT_ID=

# Text/vision, each read implicitly by its @ai-sdk/* provider. Anthropic powers
# prompt enhancement and variation prompts; Gemini powers Describe/Caption and
# shot lists. Both are absent locally and the app runs without them -- a feature
# that needs one fails loudly rather than degrading silently.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# FAL webhooks. Off by default; the app polls instead. Turning them on needs an
# APP_URL that FAL can actually reach, so localhost cannot use them. Both flags
# have to agree: the server decides whether to register the callback, the
# client decides whether to stop polling.
ENABLE_FAL_WEBHOOKS=false
NEXT_PUBLIC_ENABLE_FAL_WEBHOOKS=false
APP_URL=

# ─── Local only ───────────────────────────────────────────────────────

# Written by `pnpm local:up`, not by you: the login it generates on first run.
# Edit either and re-run local:up to change it -- the file is the source of
# truth and the password is re-synced from it, which is the whole
# password-reset story. Not something a deployment sets.
LOCAL_DEV_EMAIL=
LOCAL_DEV_PASSWORD=
