# Reference for every var genzen understands, for a deployed instance.
#
# For local development you do NOT need this file — use `.env.local.example`
# (via `pnpm local:up`), where the only value you supply is FAL_KEY.

# ─── Required ─────────────────────────────────────────────────────────

# Supabase — https://supabase.com/dashboard/project/_/settings/api
# The service role key is server-only and bypasses RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Image generation — https://fal.ai/dashboard/keys
FAL_KEY=

# Storage. Any S3-compatible bucket. Set R2_ENDPOINT explicitly, or set
# R2_ACCOUNT_ID alone to derive Cloudflare R2's endpoint. R2_PUBLIC_URL must
# be publicly readable — it is what the browser loads images from.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
VITE_R2_PUBLIC_URL=
R2_ENDPOINT=
R2_ACCOUNT_ID=

# ─── Optional ─────────────────────────────────────────────────────────

# Text/vision models. Each is read implicitly by its @ai-sdk/* provider.
# Anthropic powers prompt enhancement and variation prompts; the AD chat
# panel is BYOK from the browser, so none of these are required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# FAL webhooks. Needs a publicly reachable APP_URL; leave false to poll.
ENABLE_FAL_WEBHOOKS=false
VITE_ENABLE_FAL_WEBHOOKS=false
APP_URL=
VITE_APP_URL=

# Credit purchases. Webhook endpoint: /api/stripe-webhook
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Password gate for /docs. Unset means the route is open.
DOCS_PASSWORD=
