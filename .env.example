# ─── Supabase ─────────────────────────────────────────────────────────
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server-only -- bypasses RLS, used for admin operations (credits, MCP, etc.)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── FAL AI (image + video generation) ────────────────────────────────
# https://fal.ai/dashboard/keys
FAL_KEY=your-fal-key

# ─── Cloudflare R2 (asset storage) ────────────────────────────────────
# Create an R2 bucket + API token at https://dash.cloudflare.com/?to=/:account/r2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket
# Public URL of the bucket (custom domain or *.r2.dev). Used both server-side
# (for storage path -> URL) and client-side (for image rendering).
R2_PUBLIC_URL=https://assets.example.com
VITE_R2_PUBLIC_URL=https://assets.example.com

# ─── AI text providers ────────────────────────────────────────────────
# Each is picked up implicitly by its respective @ai-sdk/* provider --
# you don't need to reference these directly in app code.

# Anthropic (Claude) -- powers the AD assistant. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-key

# OpenAI -- https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key

# OpenRouter -- https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key

# xAI (Grok) -- https://console.x.ai/
XAI_API_KEY=your-xai-key

# ─── Google (Gemini + Imagen + vision) ────────────────────────────────
# Gemini API key -- https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key
# Service account JSON (paste full JSON as a single-line string) for
# Vertex / Imagen access. Optional unless you use those features.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ─── FAL webhooks (optional, for prod) ────────────────────────────────
# In dev keep this false -- the app falls back to on-demand polling.
# In prod set to true and expose a public URL via VITE_APP_URL (or APP_URL).
ENABLE_FAL_WEBHOOKS=false
VITE_APP_URL=https://yourapp.com
# Server-side fallback if VITE_APP_URL isn't available at runtime.
APP_URL=https://yourapp.com
# Client-side flag: when true, skip polling because webhooks will deliver results.
VITE_ENABLE_FAL_WEBHOOKS=false

# ─── Internal docs route ──────────────────────────────────────────────
# Password for /docs (the internal docs page).
DOCS_PASSWORD=change-me
