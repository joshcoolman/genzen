{
  "name": "genzen",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "node scripts/check-env-shadow.mjs && next dev --port 3000",
    "build": "next build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --check .",
    "check": "prettier --write . && eslint --fix && node scripts/check-raw-colors.mjs && node scripts/check-undeclared-tokens.mjs && node scripts/check-module-classes.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "users": "node scripts/users.mjs",
    "local:up": "node scripts/local-up.mjs",
    "local:down": "docker compose down",
    "local:reset": "docker compose down -v",
    "start": "next start --port 3000",
    "check:claude-md": "node scripts/check-claude-md.mjs",
    "check:colors": "node scripts/check-raw-colors.mjs",
    "check:tokens": "node scripts/check-undeclared-tokens.mjs",
    "check:classes": "node scripts/check-module-classes.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.46",
    "@aws-sdk/client-s3": "^3.1019.0",
    "@base-ui/react": "^1.6.0",
    "@fal-ai/client": "^1.8.5",
    "@floating-ui/react-dom": "^2.1.8",
    "@tanstack/react-hotkeys": "^0.3.0",
    "ai": "^6.0.98",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "file-saver": "^2.0.5",
    "hotkeys-js": "^4.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "marked": "^17.0.1",
    "modern-screenshot": "^4.7.0",
    "next": "^16.2.11",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "undici": "^8.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.3.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.3",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.5.3",
    "raw-loader": "^4.0.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485",
  "engines": {
    "node": ">=22.13"
  }
}
